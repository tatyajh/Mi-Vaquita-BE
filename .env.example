# database server dns name or ip address
PGHOST=
# database user
PGUSER=
# user password
PGPASSWORD=
# database name to connect
PGDATABASE=
# database port
PGPORT=5432

# Autenticación y URL pública del frontend
JWT_SECRET=
FRONTEND_URL=http://localhost:3000

# Correo transaccional (dominio remitente verificado en Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Solo desarrollo local; nunca activar en producción
SEED_DEMO_DATA=false
